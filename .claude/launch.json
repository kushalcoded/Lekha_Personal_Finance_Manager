{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-preview",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8321"],
      "port": 8321
    },
    {
      "name": "guest-page",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8322", "--directory", "build/web"],
      "port": 8322
    },
    {
      "name": "app-web",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port",
        "8323",
        "--web-hostname",
        "127.0.0.1"
      ],
      "port": 8323
    }
  ]
}
